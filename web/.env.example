# Copy to .env for local dev (npm run dev). .env is gitignored.
#
# In production these are injected at container startup instead (see
# config.js.template + docker-entrypoint.d) from the same-named FIREBASE_*
# vars passed to deploy.sh — this file only matters for local dev.
#
# Get these from the Firebase console: Project settings -> General ->
# Your apps -> Add app -> Web. See api/.env.example for full Firebase setup.
# All four are public client config values, safe to commit to a build —
# just not worth committing to git since they're per-project.
#
# Without these set, the app works exactly as before Firebase existed — no
# login screen, api/auth.py's AUTH_ENABLED gate stays off regardless of
# what's set here (that's a separate backend-side switch).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
