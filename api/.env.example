# Copy this file to .env and fill in your key. .env is gitignored — never commit real keys.
#
# Get a key: console.cloud.google.com -> create/select a project -> enable
# "Places API (New)" -> enable billing on the project (required even within
# the free tier) -> Credentials -> Create API key. Restrict it to the Places
# API before using it anywhere but localhost.
#
# Without this set, the app falls back to the curated 6-city mock dataset —
# nothing breaks, you just don't get real city search or Places grounding.
GOOGLE_PLACES_API_KEY=

# Get a key from Google AI Studio: aistudio.google.com/apikey (free tier
# available). Used by api/ingest/ to extract named venues from YouTube food
# video transcripts. Without this, `python -m ingest.run` exits immediately
# with a clear message instead of doing anything — it does not affect the
# main app, which keeps using api/data.py's hand-written Lisbon data either way.
#
# Also powers curated_food.py: a live, last-resort restaurant suggestion
# fallback for any city with zero curated/ingested food content at all
# (e.g. a city nobody has run ingest for yet — San Francisco as of this
# writing). Every suggestion is still grounded against Places before being
# shown, same as everything else; this only fills a gap, it never competes
# with or overrides real curated/ingested picks for a city that has them.
GEMINI_API_KEY=

# Optional — defaults to gemini-3.6-flash. Override if you want a
# different Gemini model for extraction.
GEMINI_MODEL=

# Optional but strongly recommended for api/ingest/. Get a key at
# supadata.ai — fetches YouTube transcripts from Supadata's own
# infrastructure instead of your local IP, avoiding the per-IP rate
# limiting/blocking YouTube applies to direct transcript requests at any
# real volume. Without this, transcripts.py falls back to a direct fetch
# (youtube-transcript-api), which works for occasional single videos but
# gets throttled fetching many videos back-to-back.
#
# Also powers ingest/scrape_articles.py — required (no fallback) for
# adding entries to ingest/run.py's ARTICLES list: real food/travel
# publication articles (Eater, Condé Nast Traveler, etc.) scraped and
# extracted the same way YouTube videos are, catching real well-regarded
# restaurants a video-only pipeline can miss (a very new or small place
# food influencers haven't covered yet, but local press has).
SUPADATA_API_KEY=

# Optional — seconds to wait between videos in `python -m ingest.run`.
# Defaults to 8. Lower this if using Supadata (rate limiting is Supadata's
# problem to manage, not yours); raise it if still hitting direct-fetch
# rate limits without a Supadata key.
INGEST_DELAY_SECONDS=

# Spotify OAuth ("Connect Spotify" on the welcome screen). Create an app at
# developer.spotify.com/dashboard to get a Client ID/Secret — this runs in
# Spotify's Dev Mode deliberately (see the design doc's "Spotify quota
# constraint" section), which means you must also add each tester's Spotify
# account email under that app's Settings -> User Management, or their
# login will fail even with correct credentials.
#
# SPOTIFY_REDIRECT_URI must exactly match a Redirect URI registered on the
# same Spotify app — for local dev that's http://127.0.0.1:8000/auth/spotify/callback
# (Spotify requires 127.0.0.1, not localhost, for non-HTTPS redirect URIs);
# for a deployed API it's <api-url>/auth/spotify/callback.
#
# Without these set, the "Connect Spotify" button redirects straight back
# with an error and falls back to the manual genre picker — nothing breaks.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=

# The web app's URL — where /auth/spotify/callback redirects the browser
# back to once OAuth finishes. Defaults to the Vite dev server's URL.
WEB_URL=

# Firebase Auth + the closed-pilot manual approval gate (CLAUDE.md: "Access
# control is manual Firestore approval, same pattern as FfAdvisor"). Setup:
#
# 1. console.firebase.google.com -> Add project -> pick your EXISTING GCP
#    project (the same one PROJECT_ID points at for deploy.sh) rather than
#    creating a new one, so Cloud Run and Firestore share a project.
# 2. Build -> Authentication -> Get started -> enable the Google sign-in
#    provider.
# 3. Build -> Firestore Database -> Create database (Native mode).
# 4. Project settings -> General -> Your apps -> Add app -> Web. Copy the
#    apiKey/authDomain/projectId/appId shown there into web/.env (see
#    web/.env.example) for local dev, or pass as FIREBASE_API_KEY etc. to
#    deploy.sh for production — these are public client config values, safe
#    to ship to the browser (Firestore's security rules are the real
#    boundary, not hiding this).
# 5. IAM & Admin -> grant the travel-api Cloud Run service's service account
#    (Cloud Run service details -> Security tab names it; usually the
#    default compute service account) the "Cloud Datastore User" role, so
#    the backend can read/write Firestore.
# 6. Set AUTH_ENABLED=true (only then does the approval gate actually turn
#    on — see auth.py's configured() for why this needs to be explicit
#    rather than inferred from Cloud Run's ambient project env vars).
# 7. Sign into the deployed app once with the Google account you'll use, so
#    a uid gets created, then in the Firestore console add a document at
#    approved_users/<that-uid> (any fields, or none — existence is what
#    "approved" checks) to unlock access for that account. There's no
#    admin UI for this by design; every new tester needs the same manual step.
#
# Local dev (running api/main.py directly, not via Cloud Run) needs one more
# thing: GOOGLE_APPLICATION_CREDENTIALS pointing at a service account key
# file (Project settings -> Service accounts -> Generate new private key),
# since there's no attached Cloud Run service account to fall back on.
#
# Without AUTH_ENABLED=true, none of this does anything — every endpoint
# stays open, same as today.
AUTH_ENABLED=
GOOGLE_APPLICATION_CREDENTIALS=

# MCP server (api/mcp_server.py) — exposes taste-matched picks as tools an
# MCP client (Claude Desktop, Claude Code, claude.ai, and increasingly
# Gemini's CLI/Vertex AI Agent Builder) can call directly. NOT the same
# integration path as ChatGPT, which wants an OpenAPI Action instead of
# MCP — that'd be a separate piece of work.
#
# Set DEPLOY_MCP=true when running deploy.sh to stand up a third Cloud Run
# service (travel-mcp) for this, alongside AUTH_ENABLED=true (this server's
# auth is a personal access token tied to an already-approved Firebase
# account — see auth.py's mint_token/verify_pat — so it needs the approval
# gate actually working). It needs the same Firestore IAM role as
# travel-api (share the service account and one grant covers both).
#
# MCP_ISSUER_URL and MCP_RESOURCE_URL are wired up automatically by
# deploy.sh once both services' URLs are known — nothing to set by hand
# unless running mcp_server.py outside that script.
#
# To get a personal access token to authenticate with: sign into the web
# app once (so an approved uid exists), then, since there's no settings-
# screen button for this yet, mint one with curl using your browser's
# current Firebase ID token (DevTools -> Application/Storage -> find the
# Firebase ID token, or add a temporary console.log(await
# firebase.auth().currentUser.getIdToken()) in the browser console):
#
#   curl -X POST <api-url>/api/tokens -H "Authorization: Bearer <that ID token>"
#
# Then configure your MCP client with the printed token as a static bearer
# header — e.g. Claude Desktop's claude_desktop_config.json:
#   "travel-discovery": {
#     "url": "<mcp-url>/mcp",
#     "headers": { "Authorization": "Bearer <token from above>" }
#   }
# claude.ai's web Connectors UI may expect a click-to-connect OAuth flow
# for custom remote servers rather than a pasted static token — this
# hasn't been verified against a real account, so Claude Desktop/Code is
# the safer bet to try first.
MCP_ISSUER_URL=
MCP_RESOURCE_URL=

# Periodic re-ingestion — keeps Firestore venue data refreshed automatically
# instead of needing someone to run `python -m ingest.run` on their laptop
# and redeploy every time coverage needs a top-up. Set DEPLOY_INGEST_JOB=true
# when running deploy.sh to stand up:
#   - a Cloud Run Job (travel-ingest) — Jobs run to completion instead of
#     serving traffic, which fits a batch re-ingest better than a Service
#     that would just idle between runs.
#   - a Cloud Scheduler job (travel-ingest-schedule) that triggers it on a
#     cron schedule (INGEST_SCHEDULE, default weekly: "0 3 * * 1", UTC),
#     via a dedicated service account with just Cloud Run Invoker on the job.
#
# Needs AUTH_ENABLED=true — that's what makes ingest.run write results to
# Firestore (venues/{slug}) instead of only an output.json file inside the
# job's ephemeral container, which is discarded when the job exits and would
# make every scheduled run pointless. Also needs the job's service account
# (same default compute service account travel-api uses, unless you've
# changed it) to have the Cloud Datastore User role — deploy.sh prints its
# email so you can check.
#
# Every firing re-runs the full curated VIDEOS list in api/ingest/run.py —
# real Gemini + Places (+ Supadata, if set) API cost each time, not free.
#
# Trigger a run immediately (without waiting for the schedule), e.g. to
# verify it works after first deploying it:
#   gcloud run jobs execute travel-ingest --region <region>
DEPLOY_INGEST_JOB=
INGEST_SCHEDULE=
