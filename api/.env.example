# Copy this file to .env and fill in your key. .env is gitignored — never commit real keys.
#
# Get a key: console.cloud.google.com -> create/select a project -> enable
# "Places API (New)" -> enable billing on the project (required even within
# the free tier) -> Credentials -> Create API key. Restrict it to the Places
# API before using it anywhere but localhost.
#
# Without this set, the app falls back to the curated 6-city mock dataset —
# nothing breaks, you just don't get real city search or Places grounding.
GOOGLE_PLACES_API_KEY=

# Get a key from Google AI Studio: aistudio.google.com/apikey (free tier
# available). Used by api/ingest/ to extract named venues from YouTube food
# video transcripts. Without this, `python -m ingest.run` exits immediately
# with a clear message instead of doing anything — it does not affect the
# main app, which keeps using api/data.py's hand-written Lisbon data either way.
GEMINI_API_KEY=

# Optional — defaults to gemini-3.6-flash. Override if you want a
# different Gemini model for extraction.
GEMINI_MODEL=
